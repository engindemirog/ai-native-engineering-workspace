#!/bin/sh
# ANEW check — THE single verification contract.
# Humans, agents, hooks, and CI all answer "is this good?" by running this one command.
# Stack-specific internals live in scripts/check.conf (generated at bootstrap).
# check.conf format: one step per line ->  <name>: <command>
#   build [fast]: ./gradlew assemble --no-daemon
#   test: ./gradlew test --no-daemon
#   lint [fast]: npm run lint
# Blank or whitespace-only lines and lines whose first non-blank character is # are ignored.
# Prerequisites: `requires <step>: <command>` attaches a project-written command to a step
# (exit 0 = met). Before the first step, each prerequisite of the profile's steps runs once per
# distinct command; an unmet one fails check before any step runs (environment gap, R-13).
# A `requires` line naming no step fails check too: a typo must not drop a prerequisite silently.
# Steps run in order, fail fast.
# Two speeds, one contract (docs/testing.md): ./scripts/check runs every step (full — the only
# evidence); ./scripts/check --fast runs only steps whose name carries [fast] (inner loop).
# A conf without [fast] tags runs every step in both profiles.
# Output: "==> <step>" before each step, "<== <step> (n s)" after it, and the total in the green
# line: CHECK GREEN (full, 14 steps, 1080 s).
set -u
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
CONF="$ROOT/scripts/check.conf"

profile=full
case "$#:${1:-}" in
  0:) ;;
  1:--fast) profile=fast ;;
  *)
    echo "usage: ./scripts/check [--fast]" >&2
    echo "  (no argument)  full profile: every step — the only evidence" >&2
    echo "  --fast         inner loop: only steps tagged [fast] in scripts/check.conf" >&2
    exit 2 ;;
esac

if [ ! -f "$CONF" ]; then
  echo "check: no scripts/check.conf yet." >&2
  echo "Run the bootstrap workflow (/bootstrap or prompts/bootstrap.md) to generate it," >&2
  echo "or copy scripts/check.conf.example and fill in your stack's commands." >&2
  exit 1
fi

# --fast on a conf with no tagged step runs everything and says so (backward compatible).
label=$profile
if [ "$profile" = fast ] && ! grep -q '^[^#:]*\[fast\][^:]*:' "$CONF"; then
  profile=full
  label="fast = full: no steps tagged fast"
fi

# Wall-clock seconds per step and in total (docs/testing.md, Two speeds): `date +%s` needs no bc
# and works in Git Bash, macOS and Linux. Where it doesn't yield a number, times are left out.
now() { t=$(date +%s 2>/dev/null); case "$t" in ''|*[!0-9]*) echo ;; *) echo "$t" ;; esac; }
took() { [ -n "$1" ] && [ -n "$2" ] && echo " ($(($2 - $1)) s)"; }   # " (12 s)" or nothing
start=$(now)

ws=" $(printf '\t\r\v\f')"   # ASCII whitespace only: the same set in every shell and locale
tab=$(printf '\t')
trim() { t=${1#"${1%%[!$ws]*}"}; printf '%s' "${t%"${t##*[!$ws]}"}"; }

# --- prerequisites, before any step; only when a requires line exists (otherwise nothing runs
# and nothing prints). A requires line: first word `requires`, then a space or tab — the same
# rule in check, doctor and residue. Pass 1 lists every step ("S<TAB>selected<TAB>name"), every
# requires line ("R<TAB>step<TAB>command") and malformed ones ("E<TAB>message"); awk pairs them,
# reports requires lines that name no step ("U"), and dedupes by command text
# ("P<TAB>steps<TAB>command", each step listed once). ---
plan=
if grep -q "^[$ws]*requires[ $tab]" "$CONF"; then
  plan=$(
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in *[!$ws]*) ;; *) continue ;; esac
      rest=${line#"${line%%[!$ws]*}"}
      case "$rest" in
        \#*) continue ;;
        requires[" $tab"]*)
          case "$rest" in
            *:*) ;;
            *) printf "E\trequires line has no ':': %s\n" "$(trim "$rest")"; continue ;;
          esac
          name=$(trim "${rest%%:*}"); name=$(trim "${name#requires}")
          cmd=$(trim "${rest#*:}")
          if [ -z "$cmd" ]; then printf 'E\trequires has no command: %s\n' "$name"; continue; fi
          printf 'R\t%s\t%s\n' "$name" "$cmd"
          continue ;;
      esac
      name=${line%%:*}
      case "$name" in
        *"[fast]"*) sel=1 ;;
        *) if [ "$profile" = fast ]; then sel=0; else sel=1; fi ;;
      esac
      printf 'S\t%s\t%s\n' "$sel" "$(trim "$(printf '%s' "$name" | sed 's/[[:space:]]*\[fast\]//')")"
    done < "$CONF" | awk '
      $1 == "E" { print; next }
      $1 == "S" { s = substr($0, 3); n = substr(s, 3); known[n] = 1; if (substr(s, 1, 1) == "1") want[n] = 1; next }
      $1 == "R" { r = substr($0, 3); i = index(r, "\t"); st[++k] = substr(r, 1, i - 1); cm[k] = substr(r, i + 1) }
      END {
        for (j = 1; j <= k; j++) if (!(st[j] in known)) printf "U\t%s\n", st[j]
        for (j = 1; j <= k; j++) {
          if (!(st[j] in want)) continue
          c = cm[j]
          if ((c SUBSEP st[j]) in pair) continue
          pair[c SUBSEP st[j]] = 1
          if (!(c in on)) { order[++m] = c; on[c] = st[j] } else on[c] = on[c] ", " st[j]
        }
        for (j = 1; j <= m; j++) printf "P\t%s\t%s\n", on[order[j]], order[j]
      }'
  )
fi
unmet=0
while IFS= read -r entry; do
  [ -n "$entry" ] || continue
  kind=${entry%%"$tab"*}; entry=${entry#*"$tab"}
  case "$kind" in
    E) printf 'CHECK FAILED (%s) %s\n' "$label" "$entry" >&2; unmet=$((unmet + 1)); continue ;;
    U) printf 'CHECK FAILED (%s) requires names no step: %s\n' "$label" "$entry" >&2; unmet=$((unmet + 1)); continue ;;
  esac
  on=${entry%%"$tab"*}; cmd=${entry#*"$tab"}
  if pout=$(cd "$ROOT" && sh -c "$cmd" </dev/null 2>&1); then
    printf 'ok    prerequisite: %s (steps: %s)\n' "$cmd" "$on"
  else
    [ -n "$pout" ] && printf '%s\n' "$pout"
    printf 'CHECK FAILED (%s) prerequisite not met: %s (steps: %s) — environment gap, see prompts/recovery/environment-gap.md (R-13)\n' "$label" "$cmd" "$on" >&2
    unmet=$((unmet + 1))
  fi
done <<EOF
$plan
EOF
[ "$unmet" -eq 0 ] || exit 1

steps=0
while IFS= read -r line || [ -n "$line" ]; do
  # Whitespace-only lines (a stray CR included) and indented comments are not steps either:
  # each would run as an empty command and count as a green step.
  case "$line" in *[!$ws]*) ;; *) continue ;; esac
  case "${line#"${line%%[!$ws]*}"}" in \#*|requires[" $tab"]*) continue ;; esac
  name=${line%%:*}
  cmd=${line#*:}
  case "$name" in
    *"[fast]"*) name=$(printf '%s' "$name" | sed 's/[[:space:]]*\[fast\]//') ;;
    *) if [ "$profile" = fast ]; then echo "skip  $name (full only)"; continue; fi ;;
  esac
  steps=$((steps + 1))
  echo "==> $name"
  t0=$(now)
  # </dev/null: a step that reads stdin must not swallow the rest of check.conf (silent false green).
  if ! ( cd "$ROOT" && sh -c "$cmd" </dev/null ); then
    echo "<== $name$(took "$t0" "$(now)")"
    echo "CHECK FAILED ($label) at step: $name" >&2
    exit 1
  fi
  echo "<== $name$(took "$t0" "$(now)")"
done < "$CONF"

if [ "$steps" -eq 0 ]; then
  echo "check: check.conf has no steps — greenfield no-op. Add steps as soon as code exists."
  exit 0
fi
total=$(took "$start" "$(now)")   # " (n s)" → ", n s" inside the green line
total=${total# (}; total=${total%)}
echo "CHECK GREEN ($label, $steps steps${total:+, $total})"
