#!/bin/sh
# ANEW status — where every piece of work stands: one row per spec in specs/active/ and specs/done/,
# with its stage, who acts next and the next step, in the words of workflows/segments.md.
# Read-only: it writes no file and keeps no state; the files stay the only record.
# Exit 0 = the workspace was read (warnings included), exit 2 = usage.
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
usage() { echo "usage: scripts/status [--json]" >&2; exit 2; }
json=0
[ $# -le 1 ] || usage
case "${1:-}" in
  "") ;;
  --json) json=1 ;;
  *) usage ;;
esac

if git -C "$ROOT" rev-parse --verify -q HEAD >/dev/null 2>&1; then has_git=1; else has_git=0; fi

# The file as status reads it: CR stripped, HTML comments and fenced blocks dropped — a template
# comment holds example headings and evidence lines that are not records.
clean() { clean_in < "$1"; }
clean_in() {
  tr -d '\r' | awk '
    !incom && /^[ \t]*```/ { fence = !fence; next }
    fence { next }
    { line = $0; out = ""
      while (line != "") {
        if (incom) { i = index(line, "-->"); if (!i) { line = ""; break }
                     line = substr(line, i + 3); incom = 0; continue }
        i = index(line, "<!--")
        if (!i) { out = out line; break }
        out = out substr(line, 1, i - 1); line = substr(line, i + 4); incom = 1
      }
      if (out ~ /^[ \t]*$/ && $0 !~ /^[ \t]*$/) next
      print out }'
}
# field <file> <label>: the value of the first "- <label>: …" line, trimmed.
field() { clean "$1" | sed -n "s|^- $2:[[:space:]]*||p" | head -n 1 | sed 's/[[:space:]]*$//'; }
# section <heading prefix>: the lines of the "## <prefix>…" section of a cleaned file on stdin.
section() { awk -v h="## $1" 'index($0, "## ") == 1 { ins = (index($0, h) == 1); next } ins'; }
# The newest triage round of a plan: "<review|verify><TAB><real findings><TAB><heading>".
newest_round() {
  clean "$1" | section "Triage" | awk -F'|' '
    /^### (Review|VERIFY) round/ { k = ($0 ~ /^### Review/) ? "review" : "verify"; h = $0; r = 0; row = 0; next }
    /^### / { k = ""; next }
    k != "" && /^\|/ {
      if ($0 ~ /^\|[-:| ]+$/) next
      if (++row == 1) next
      v = tolower($3); gsub(/^[ \t*]+|[ \t*]+$/, "", v)
      if (v ~ /^real/) r++
      lk = k; lr = r; lh = h; next }
    k != "" { lk = k; lr = r; lh = h }
    END { if (lk != "") printf "%s\t%d\t%s\n", lk, lr, lh }'
}
# fixed_after <n> <plan path, repo-relative> <round heading>: a [plan n/fix-k] commit exists after
# the commit that recorded that round. 0 = yes, 1 = no, 2 = git cannot tell.
fixed_after() {
  [ "$has_git" -eq 1 ] || return 2
  c=$(git -C "$ROOT" log --format=%H --reverse -S"$3" -- "$2" 2>/dev/null | head -n 1)
  [ -n "$c" ] || return 1
  git -C "$ROOT" log --format=%s "$c..HEAD" 2>/dev/null | grep -qF "[plan $1/fix-"
}

# evidence_age <plan>: a warning when the last "CHECK GREEN (full, …) @<sha>" line no longer proves
# the code — files outside specs/ and .anew-dev/ changed since <sha>, committed or not
# (docs/testing.md, rule 6), or <sha> is not a commit here.
evidence_age() {
  line=$(clean "$1" | section "Build evidence" | grep -F 'CHECK GREEN (full,' | tail -n 1)
  [ -n "$line" ] || return 0
  sha=$(printf '%s\n' "$line" | sed -n 's/.*@\([0-9a-fA-F]\{7,40\}\).*/\1/p')
  if [ -z "$sha" ]; then echo "the evidence line has no @<sha>: status cannot check its age"; return 0; fi
  [ "$has_git" -eq 1 ] || return 0
  if ! git -C "$ROOT" cat-file -e "$sha^{commit}" 2>/dev/null; then
    echo "evidence @$sha is not a commit in this repository — re-run ./scripts/check and record it"; return 0
  fi
  changed=$( { git -C "$ROOT" diff --name-only "$sha" HEAD -- . ':!specs' ':!.anew-dev'
               git -C "$ROOT" status --porcelain -- . ':!specs' ':!.anew-dev' | cut -c4-; } 2>/dev/null | sort -u)
  [ -n "$changed" ] || return 0
  count=$(printf '%s\n' "$changed" | wc -l | tr -d ' ')
  more=""; [ "$count" -gt 1 ] && more=" (+$((count - 1)) more)"
  echo "evidence is older than the code: CHECK GREEN @$sha, then changed: $(printf '%s\n' "$changed" | head -n 1)$more — re-run ./scripts/check and record it"
}

# --- changed after approval (spec 0006, Requirement 4) ---
# region <spec|plan>: the approved content of a cleaned file on stdin, one "<section><TAB><line>"
# per line. Later records are left out: status lines, build evidence, triage, amendments. A
# criterion keeps its text only: box, strike-through and a "→ moved to …" tail are cut.
region() {
  awk -v kind="$1" '
    /^## / { s = ""; h = substr($0, 4)
      if (kind == "spec" && $0 ~ /^## (Intent|Requirements|User experience|Constraints|Acceptance criteria)/) s = h
      if (kind == "plan" && $0 ~ /^## (Files to change|Ordered steps|Risks|Criterion)/) s = h
      if (s != "") print s "\t"
      next }
    s == "" { next }
    { line = $0; sub(/[ \t]+$/, "", line)
      if (s ~ /^Acceptance criteria/ && line ~ /^[ \t]*- \[[ xX]\]/) {
        sub(/^[ \t]*- \[[ xX]\][ \t]*/, "- ", line); gsub(/~~/, "", line)
        sub(/[ \t]*(→|->)[ \t]*moved to .*/, "", line) }
      print s "\t" line }'
}
# changed_sections <old region> <new region>: the sections whose lines differ, comma-separated.
changed_sections() {
  { printf '%s\n' "$1" | awk '{ print "A\t" $0 }'; printf '%s\n' "$2" | awk '{ print "B\t" $0 }'; } | awk -F'\t' '
    NF >= 2 { k = $2; t[$1, k] = t[$1, k] substr($0, length($1) + length($2) + 3) "\n"; ks[k] = 1 }
    END { for (k in ks) if (t["A", k] != t["B", k]) print k }' | sort | awk '{ o = o (NR > 1 ? ", " : "") $0 } END { print o }'
}
amendment_ids() { section "Amendments" | sed -n 's/^[-* ]*\(A-[0-9][0-9]*\).*/\1/p' | sort -u; }
# approval_commit <plan, repo-relative>: the oldest commit whose plan holds an Approved by / on value.
approval_commit() {
  git -C "$ROOT" log --format=%H --reverse -- "$1" 2>/dev/null | while IFS= read -r c; do
    a=$(git -C "$ROOT" show "$c:$1" 2>/dev/null | clean_in | sed -n 's|^- Approved by / on:[[:space:]]*||p' | head -n 1 | sed 's/[[:space:]]*$//')
    case "$a" in ""|"-"|"—") ;; *) echo "$c"; break ;; esac
  done
}
# drift <spec> <spec, repo-relative> <plan> <plan, repo-relative>: adds to $warns and $infos.
drift() {
  if [ "$has_git" -eq 0 ]; then
    infos="${infos}no git history: changes after approval cannot be checked
"; return 0
  fi
  c=$(approval_commit "$4")
  if [ -z "$c" ]; then
    infos="${infos}the plan approval is not committed yet: changes after approval cannot be checked
"; return 0
  fi
  short=$(git -C "$ROOT" rev-parse --short "$c")
  if git -C "$ROOT" cat-file -e "$c:$2" 2>/dev/null; then
    d=$(changed_sections "$(git -C "$ROOT" show "$c:$2" | clean_in | region spec)" "$(clean "$1" | region spec)")
    [ -n "$d" ] && warns="${warns}the spec changed after approval (@$short): $d — get it re-approved, or revert
"
  else
    infos="${infos}the spec is not at $2 in the approval commit @$short: its changes cannot be checked
"
  fi
  d=$(changed_sections "$(git -C "$ROOT" show "$c:$4" | clean_in | region plan)" "$(clean "$3" | region plan)")
  [ -n "$d" ] || return 0
  new=$({ git -C "$ROOT" show "$c:$4" | clean_in | amendment_ids; echo "--"; clean "$3" | amendment_ids; } | awk '$0 == "--" { b = 1; next } !b { old[$0] = 1; next } !($0 in old) { o = o (o ? ", " : "") $0 } END { print o }')
  if [ -n "$new" ]; then infos="${infos}amended ($new): the plan's $d changed after approval (@$short)
"
  else warns="${warns}the plan changed after approval (@$short): $d — record an amendment (A-<n>) or get it re-approved
"
  fi
}

# --- output: text, or JSON (shape in docs/commands.md) ---
rows=0
notes=""
note() { notes="$notes$1
"; }
emit() {  # emit <n> <name> <spec status> <plan status> <stage> <who> <next> <warnings> <notes> (one per line)
  rows=$((rows + 1))
  if [ "$5" = "shipped" ]; then
    printf '%s  %s  shipped\n' "$1" "$2"
  else
    printf '%s  %s  spec: %s · plan: %s  →  %s%s\n' "$1" "$2" "$3" "$4" "$5" "${6:+ ($6)}"
    [ -n "$7" ] && printf '      next: %s\n' "$7"
  fi
  printf '%s' "$8" | while IFS= read -r w; do [ -n "$w" ] && printf '      WARN  %s\n' "$w"; done
  printf '%s' "${9:-}" | while IFS= read -r w; do [ -n "$w" ] && printf '      note  %s\n' "$w"; done
}

[ "$has_git" -eq 1 ] || note "no git history: evidence age and changes after approval cannot be checked"

[ "$json" -eq 1 ] || echo "== ANEW status =="
for spec in "$ROOT/specs/active/"[0-9]*.md "$ROOT/specs/done/"[0-9]*.md; do
  [ -f "$spec" ] || continue
  b=$(basename "$spec" .md)
  n=${b%%-*}
  name=${b#*-}
  plan="$ROOT/specs/plans/$n-plan.md"
  planrel="specs/plans/$n-plan.md"
  warns=""; infos=""
  case "$spec" in
    "$ROOT/specs/done/"*) emit "$n" "$name" "Shipped" "" "shipped" "" "" ""; continue ;;
  esac
  st=$(field "$spec" "Status")
  if [ -f "$plan" ]; then
    pst=$(field "$plan" "Status")
    appr=$(field "$plan" "Approved by / on")
    case "$appr" in ""|"-"|"—") approved=0 ;; *) approved=1 ;; esac
  else
    pst="—"; approved=0
  fi
  stage=""; who=""; next=""
  case "$st" in
    Draft)
      if [ -f "$plan" ]; then stage="unclear: a plan exists but the spec is Draft"
      else stage="ANALYZE"; who="human"; next="approve the spec (end of /analyze)"; fi ;;
    Approved)
      if [ ! -f "$plan" ]; then stage="PLAN"; who="Developer"; next="/plan — then the human approves the plan"
      elif [ "$approved" -eq 0 ]; then stage="PLAN"; who="human"; next="approve the plan: Status: Approved + Approved by / on: <name>, <YYYY-MM-DD>"
      else stage="BUILD"; who="Developer"; next="/build"; fi ;;
    "In progress")
      if [ ! -f "$plan" ]; then stage="unclear: the spec is In progress but has no plan"
      elif [ "$approved" -eq 0 ]; then stage="unclear: build started but the plan has no Approved by / on"
      elif ! clean "$plan" | section "Build evidence" | grep -qF 'CHECK GREEN (full,'; then
        stage="BUILD"; who="Developer"; next="finish the plan's steps; record ./scripts/check (full) in ## Build evidence"
      else
        ew=$(evidence_age "$plan")
        [ -n "$ew" ] && warns="$warns$ew
"
        round=$(newest_round "$plan")
        if [ -z "$round" ]; then
          stage="REVIEW"; who="fresh session / read-only reviewer"
          next="/review; then TRIAGE — human (a review writes no file: status cannot tell whether it ran)"
        else
          kind=$(printf '%s' "$round" | cut -f1); reals=$(printf '%s' "$round" | cut -f2); head=$(printf '%s' "$round" | cut -f3-)
          open=0
          if [ "$reals" -gt 0 ]; then
            fixed_after "$n" "$planrel" "$head"
            case $? in 0) ;; 1) open=1 ;; 2) open=1; warns="${warns}no git history: status cannot see the fix commits
" ;; esac
          fi
          if [ "$open" -eq 1 ]; then
            stage="FIX ROUND"; who="Developer"
            next="fix the real findings of '${head#\#\#\# }': one commit each, [plan $n/fix-k]; then VERIFY — QA (a Medium or higher round is re-reviewed first)"
          elif [ "$kind" = "review" ] || [ "$reals" -gt 0 ]; then
            stage="VERIFY"; who="QA"
            next="/verify in a fresh session (a clean VERIFY writes no triage table: status cannot tell whether it ran)"
          else
            stage="SHIP"; who="human"
            next="DoD, tick the proven criteria, move the spec to specs/done/ with Status: Shipped in the PR, merge"
          fi
        fi
      fi ;;
    *) stage="unclear: spec status '${st:-none}' is not Draft, Approved or In progress" ;;
  esac
  [ "$approved" -eq 1 ] && drift "$spec" "specs/active/$b.md" "$plan" "$planrel"
  emit "$n" "$name" "${st:-—}" "${pst:-—}" "$stage" "$who" "$next" "$warns" "$infos"
done
[ "$rows" -gt 0 ] || echo "no work yet — start with /new-feature or /analyze"
printf '%s' "$notes" | while IFS= read -r l; do [ -n "$l" ] && printf 'note  %s\n' "$l"; done
exit 0
