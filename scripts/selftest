#!/bin/sh
# ANEW selftest — proves that scripts/check, scripts/doctor and scripts/residue behave as documented.
# Every scenario runs in a throwaway copy of this workspace in a temp dir OUTSIDE the repo
# (docs/testing.md, Evidence policy), asserts on the real output and exit code, and is deleted.
# Exit 0 = all scenarios pass, exit 1 = at least one failed. Runs in CI next to doctor.
set -u
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
passed=0
failed=0
TMP=$(mktemp -d "${TMPDIR:-/tmp}/anew-selftest.XXXXXX") || { echo "selftest: mktemp failed" >&2; exit 1; }
trap 'rm -rf "$TMP"' EXIT INT TERM

# --- assertions on the last run: $out (stdout+stderr) and $rc ---
run()    { out=$("$@" 2>&1); rc=$?; }
report() { if [ "$1" -eq 0 ]; then passed=$((passed + 1)); echo "ok    $2"
           else failed=$((failed + 1)); echo "FAIL  $2"; printf '%s\n' "$out" | sed 's/^/      | /'; fi; }
exits()  { [ "$rc" -eq "$1" ]; report $? "$2 (exit $1)"; }
has()    { printf '%s\n' "$out" | grep -qF -- "$1"; report $? "$2"; }
hasnt()  { if printf '%s\n' "$out" | grep -qF -- "$1"; then report 1 "$2"; else report 0 "$2"; fi; }

# --- scripts/check: a bare copy of the script with a conf per scenario ---
C="$TMP/check"
mkdir -p "$C/scripts"
cp "$ROOT/scripts/check" "$C/scripts/check"
conf() { printf '%s\n' "$@" > "$C/scripts/check.conf"; }
check() { run sh "$C/scripts/check" "$@"; }

echo "== scripts/check =="
check
exits 1 "no check.conf → refuses";                has "no scripts/check.conf yet" "no check.conf → says so"
conf '# only a comment'
check
exits 0 "conf without steps → greenfield no-op";  has "greenfield no-op" "no-op is named"
printf '   \n\t\n\r\n  # indented comment\n' > "$C/scripts/check.conf"
check
has "greenfield no-op" "whitespace-only lines, a CR line and an indented comment are not steps"
hasnt "CHECK GREEN" "… and never count as a green step"
printf '\302\240\n' > "$C/scripts/check.conf"   # a no-break space: not ASCII whitespace
check
hasnt "greenfield no-op" "a non-ASCII space line is a step in every shell (as for doctor and residue)"
conf 'compile [fast]: echo compile ran' 'unit [fast]: echo unit ran' 'e2e: echo e2e ran'
check --fast
exits 0 "--fast, tagged conf";                    has "CHECK GREEN (fast, 2 steps" "--fast runs only [fast] steps"
has "skip  e2e (full only)" "--fast names the skipped step";  hasnt "e2e ran" "--fast does not run untagged steps"
has "==> unit" "tag is stripped from the displayed name";     hasnt "==> unit [fast]" "tag never shown as part of the name"
check
exits 0 "full, tagged conf";                      has "CHECK GREEN (full, 3 steps" "full runs every step"
conf 'compile: echo compile ran' 'e2e: echo e2e ran'
check --fast
has "CHECK GREEN (fast = full: no steps tagged fast, 2 steps" "--fast on an untagged conf runs all and says so"
conf 'compile: echo compile ran' 'unit: echo unit; exit 3' 'after: echo after ran'
check
exits 1 "red step fails the run";                 has "CHECK FAILED (full) at step: unit" "failure names profile and step"
hasnt "after ran" "fail fast: later steps do not run"
conf 'unit [fast]: exit 3'
check --fast
exits 1 "red fast step";                          has "CHECK FAILED (fast) at step: unit" "fast failure names the profile"
check --fsat
exits 2 "unknown argument";                       has "usage:" "unknown argument prints usage"
check --fast extra
exits 2 "extra argument";                         hasnt "==>" "a bad invocation runs nothing"
conf 'first: echo first ran' 'greedy: cat > /dev/null; echo greedy ran' 'second: echo second ran'
check
has "second ran" "a step reading stdin cannot swallow the rest of check.conf"
has "CHECK GREEN (full, 3 steps" "every step after a stdin reader still counts"
# Durations: asserted present, never their value.
matches() { printf '%s\n' "$out" | grep -qE -- "$1"; report $? "$2"; }
conf 'compile [fast]: echo compile ran' 'unit: exit 3'
check --fast
matches '^<== compile \([0-9]+ s\)$' "each step reports its duration"
matches '^CHECK GREEN \(fast, 1 steps, [0-9]+ s\)$' "the green line carries the total duration"
check
matches '^<== unit \([0-9]+ s\)$' "a failing step still reports its duration"
mkdir -p "$TMP/nodate"; printf '#!/bin/sh\necho unknown\n' > "$TMP/nodate/date"; chmod +x "$TMP/nodate/date"
run env PATH="$TMP/nodate:$PATH" sh "$C/scripts/check" --fast
matches '^CHECK GREEN \(fast, 1 steps\)$' "no usable clock: times are left out, the run still counts"

# Prerequisites (requires <step>: <command>): evaluated before step 1, once per distinct command.
conf 'compile [fast]: echo compile ran' 'e2e: echo e2e ran'
check
hasnt "prerequisite" "no requires line → no prerequisite output (unchanged behavior)"
conf 'compile [fast]: echo compile ran' 'unit [fast]: echo unit ran' 'e2e: echo e2e ran' \
     'requires compile: echo met-output; true' 'requires e2e: echo miss""ing-runtime-text; exit 4'
check
exits 1 "unmet prerequisite fails check"
hasnt "compile ran" "unmet prerequisite on the last step: not even the first step runs"
hasnt "==>" "… no step marker at all";            hasnt "CHECK GREEN" "… and no green line"
has "CHECK FAILED (full) prerequisite not met: echo miss\"\"ing-runtime-text; exit 4 (steps: e2e)" "failure names command and step"
has "environment gap, see prompts/recovery/environment-gap.md (R-13)" "failure points at R-13"
has "missing-runtime-text" "an unmet prerequisite shows its output"
has "ok    prerequisite: echo met-output; true (steps: compile)" "a met prerequisite is one ok line"
printf '%s\n' "$out" | grep -qx 'met-output'; [ $? -ne 0 ]; report $? "a met prerequisite's output is not printed"
check --fast
exits 0 "--fast ignores prerequisites of full-only steps"; has "CHECK GREEN (fast, 2 steps" "… and runs the fast steps"
conf 'a: echo a ran' 'requires a: no-such-cmd-anew'
check
exits 1 "missing prerequisite command → not met";  has "not found" "… with the shell's error text"
has "CHECK FAILED (full) prerequisite not met: no-such-cmd-anew" "… reported, check does not abort"
conf 'a: echo a ran' 'requires b: true'
check
exits 1 "requires naming no step fails check";     has "requires names no step: b" "… and names it"
: > "$TMP/req-count"
conf 'a [fast]: true' 'b: true' 'c: true' "requires a: echo x >> '$TMP/req-count'" \
     "requires b: echo x >> '$TMP/req-count'" "requires c: echo x >> '$TMP/req-count'"
check
exits 0 "shared prerequisite, met";                has "(steps: a, b, c)" "… listed once for all its steps"
[ "$(wc -l < "$TMP/req-count" | tr -d ' ')" -eq 1 ]; report $? "a prerequisite on three steps runs once per check run"
conf 'a: true' 'requires a: true' 'requires a: true'
check;             has "ok    prerequisite: true (steps: a)" "the same requires line twice lists its step once"
conf 'a: echo a ran' 'requires a:'
check
exits 1 "requires with an empty command fails check"; has "CHECK FAILED (full) requires has no command: a" "… and says so"
hasnt "a ran" "… before any step"
conf 'a: echo a ran' 'requires a: # runtime to be decided'
check
exits 1 "a comment-only prerequisite command fails check"; has "requires has no command: a" "… as no command"
conf 'a: echo a ran' 'requires : true'
check;             has "requires names no step: (empty)" "an empty step name is shown as (empty)"
conf 'a: echo a ran' 'requires a'
check
exits 1 "requires line without ':' fails check";  has "requires line has no ':': requires a" "… as a conf error"
hasnt "environment gap" "… not as an environment gap"
printf 'requires\fx: echo ff ran\n' > "$C/scripts/check.conf"
check;             has "ff ran" "only a space or tab after 'requires' makes a requires line (as in doctor and residue)"
printf 'a: echo a ran\r\nrequires a: true\r\n' > "$C/scripts/check.conf"
check
exits 0 "CRLF conf with a requires line";         has "ok    prerequisite: true (steps: a)" "… pairs step and prerequisite"

# --- scripts/residue: same bare copy. Assertions never require an idle machine: they look for
# this run's own marker, so another process starting meanwhile cannot make them flaky.
cp "$ROOT/scripts/residue" "$C/scripts/residue"
residue() { run env ANEW_RESIDUE_SETTLE=1 ANEW_RESIDUE_MB=1000000 sh "$C/scripts/residue" "$@"; }
LEAK=anew-residue-leak-$$

echo "== scripts/residue =="
residue --fsat
exits 2 "residue: unknown argument";             has "usage:" "residue: prints usage"
printf '# only a comment\n\n  # indented\n \r\n' > "$C/scripts/check.conf"
residue
exits 0 "residue: conf without steps";           has "RESIDUE NOT MEASURED (full)" "no steps → not measured, never clean"
hasnt "baseline: " "no steps → nothing is measured"
conf '# a prerequisite alone' 'requires unit: true'
residue
has "RESIDUE NOT MEASURED (full)" "residue: a requires line is not a step"
printf 'requires\fx: true\n' > "$C/scripts/check.conf"
residue
hasnt "RESIDUE NOT MEASURED" "residue: only a space or tab after 'requires' makes a requires line (as in check)"
conf 'unit [fast]: exit 3'
residue
exits 1 "residue: red check";                    has "RESIDUE TEST ABORTED (full): check failed in run 1" "red check aborts the residue test"
conf "unit [fast]: sh -c 'sleep 1; :' $LEAK" "e2e: echo e2e ran"
residue --fast
has "baseline: " "residue: measures a baseline";   has "after run 2: " "residue: measures after both runs"
has "==> run 2/2: ./scripts/check --fast" "residue --fast runs the fast profile twice"; hasnt "e2e ran" "residue --fast skips full-only steps"
if printf '%s\n' "$out" | grep '^  survivor  ' | grep -qF "$LEAK"; then report 1 "a step that waits for its child leaves no survivor"
else report 0 "a step that waits for its child leaves no survivor"; fi
# The scenario processes below write their pid and are stopped afterwards: the selftest itself
# leaves nothing running. Each one also ends on its own after ~30 s, should a kill miss it.
LIVE='echo $$ >> "$1"; i=0; while [ $i -lt 30 ]; do sleep 1; i=$((i + 1)); done'
conf "unit: echo unit ran" "server: sh -c '$LIVE' $LEAK '$TMP/leak.pid' >/dev/null 2>&1 &"
residue
kill $(cat "$TMP/leak.pid" 2>/dev/null) 2>/dev/null
exits 1 "residue: leaked process";               has "RESIDUE FOUND (full)" "leak is reported"
has "$LEAK" "the survivor is named with its command line"
if printf '%s\n' "$out" | grep '^  survivor  ' | grep -F "$LEAK" | grep -qF '(parent '; then report 0 "the survivor names its parent"
else report 1 "the survivor names its parent"; fi
# A process started meanwhile by something outside check — here a watcher started before the
# baseline, not an ancestor of the test — is not check's: listed with its parent, never failing.
GO="$TMP/go"; FOREIGN_MARK=anew-residue-foreign-$$
( while [ ! -f "$GO" ]; do sleep 1; done; sh -c "$LIVE" "$FOREIGN_MARK" "$TMP/foreign.pid" & wait ) &
WATCH=$!
conf "unit: touch '$GO' && sleep 3"
residue
kill "$WATCH" $(cat "$TMP/foreign.pid" 2>/dev/null) 2>/dev/null
exits 0 "residue: a process from outside check does not fail it"; has "RESIDUE CLEAN (full, 2 runs)" "… the verdict is clean"
if printf '%s\n' "$out" | grep '^  not from check  ' | grep -F "$FOREIGN_MARK" | grep -qF '(parent '; then report 0 "… and it is listed as not from check, with its parent"
else report 1 "… and it is listed as not from check, with its parent"; fi
# The POSIX path on any machine: a fake uname and ps (pid, ppid, args). After the baseline, a
# kernel thread appears (never a survivor) and, on request, a zombie (always one), a process whose
# parent is a live baseline process (not from check), and orphans: one handed to init, one whose
# parent is a new process whose own parent is gone (both check's).
mkdir -p "$TMP/fakeps"
printf '#!/bin/sh\necho Linux\n' > "$TMP/fakeps/uname"
cat > "$TMP/fakeps/ps" <<'EOF2'
#!/bin/sh
n=$(($(cat "$PSCOUNT" 2>/dev/null || echo 0) + 1)); echo "$n" > "$PSCOUNT"
echo "    1     0 /sbin/init"
echo "  100     1 /usr/bin/anew-other-session"
[ "$n" -gt 2 ] || exit 0
echo " 4242     2 [kworker/0:1-events]"
[ -z "${ZOMBIE:-}" ] || echo " 4243     1 [anew-zombie] <defunct>"
[ -z "${FOREIGN:-}" ] || echo " 4244   100 anew-foreign --flag"
[ -z "${ORPHANS:-}" ] || { echo " 4245     1 anew-orphan"; echo " 4246  4247 anew-child"; echo " 4247  9999 anew-parent-gone"; }
EOF2
chmod +x "$TMP/fakeps/uname" "$TMP/fakeps/ps"
conf 'unit [fast]: echo unit ran'
fakeps() { rm -f "$TMP/fakeps/count"; run env PATH="$TMP/fakeps:$PATH" PSCOUNT="$TMP/fakeps/count" "$@" \
             ANEW_RESIDUE_SETTLE=1 ANEW_RESIDUE_MB=1000000 sh "$C/scripts/residue" --fast; }
fakeps
exits 0 "residue: a kernel thread is not a survivor"; hasnt "kworker" "kernel threads are never listed"
fakeps ZOMBIE=1
exits 1 "residue: a zombie is a survivor";       has "[anew-zombie] <defunct>" "the zombie is named"
fakeps FOREIGN=1
exits 0 "residue: a child of a live baseline process is not check's"
has "  not from check  4244  anew-foreign --flag  (parent 100 anew-other-session)" "… listed with its parent"
has "0 survivor(s), 1 not from check" "… counted apart";  hasnt "  survivor  4244" "… never as a survivor"
fakeps FOREIGN=1 ORPHANS=1
exits 1 "residue: orphans are check's"
has "  survivor  4245  anew-orphan  (parent 1 init)" "an orphan handed to init is a survivor"
has "  survivor  4247  anew-parent-gone  (parent 9999 gone)" "a process whose parent is gone is a survivor"
has "  survivor  4246  anew-child  (parent 4247 anew-parent-gone)" "a child of an orphan is a survivor too"
has "  not from check  4244" "… while the other session's process stays not from check"
# Memory is reported, never judged: a fake Darwin with vm_stat whose free pages halve after the
# baseline drops ~3.9 GB, over a 512 MB tolerance, with nothing of check's left.
mkdir -p "$TMP/fakemac"
printf '#!/bin/sh\necho Darwin\n' > "$TMP/fakemac/uname"
cat > "$TMP/fakemac/vm_stat" <<'EOF2'
#!/bin/sh
n=$(($(cat "$VMCOUNT" 2>/dev/null || echo 0) + 1)); echo "$n" > "$VMCOUNT"
echo "Mach Virtual Memory Statistics: (page size of 4096 bytes)"
if [ "$n" -gt 2 ]; then echo "Pages free:                     1000000."; else echo "Pages free:                     2000000."; fi
EOF2
cp "$TMP/fakeps/ps" "$TMP/fakemac/ps"
chmod +x "$TMP/fakemac/uname" "$TMP/fakemac/vm_stat" "$TMP/fakemac/ps"
rm -f "$TMP/fakemac/count" "$TMP/fakemac/vmcount"
run env PATH="$TMP/fakemac:$PATH" PSCOUNT="$TMP/fakemac/count" VMCOUNT="$TMP/fakemac/vmcount" \
  ANEW_RESIDUE_SETTLE=1 ANEW_RESIDUE_MB=512 sh "$C/scripts/residue" --fast
exits 0 "residue: a memory drop alone does not fail it"
has "over the 512 MB tolerance (informational" "… it is reported as informational"
has "RESIDUE CLEAN (fast, 2 runs)" "… and the verdict is clean"

# --- scripts/doctor: a git-initialised copy of the ANEW core only, reset between scenarios ---
# Only what doctor reads: no application code, and no real specs or plans (a project's own specs
# would collide with the scenarios) — so the selftest behaves the same in the template and in
# every bootstrapped project.
W="$TMP/ws"
mkdir -p "$W"
( cd "$ROOT" && git ls-files --cached --others --exclude-standard ) \
  | grep -E '^(AGENTS\.md|README\.md|\.anew-version|docs/|workflows/|prompts/|scripts/|adapters/|specs/(TEMPLATE[^/]*\.md|(active|done|plans)/README\.md|plans/TEMPLATE\.md)$)' \
  | ( cd "$ROOT" && tar -cf - -T - ) | ( cd "$W" && tar -xf - )
git -C "$W" init -q
git -C "$W" config core.autocrlf false   # the fixture is throwaway: no line-ending conversion noise
git -C "$W" config core.safecrlf false
git -C "$W" add -A
git -C "$W" -c user.name=selftest -c user.email=selftest@example.invalid commit -qm fixture
BASE=$(git -C "$W" rev-parse HEAD)
reset()  { git -C "$W" reset -q --hard "$BASE"; git -C "$W" clean -qfdx; }
commit() { git -C "$W" add -A; git -C "$W" -c user.name=selftest -c user.email=selftest@example.invalid commit -qm "$1"; }
put()    { mkdir -p "$(dirname "$W/$1")"; f=$1; shift; printf '%s\n' "$@" > "$W/$f"; }
# CI's base-ref and event variables would point doctor at refs and a payload the fixture doesn't
# have; doctor_pr <payload> sets the event payload on purpose.
doctor() { run sh -c 'unset ANEW_BASE_REF GITHUB_BASE_REF GITHUB_EVENT_PATH; exec sh "$0" "$@"' "$W/scripts/doctor" "$@"; }
doctor_pr() { run sh -c 'unset ANEW_BASE_REF GITHUB_BASE_REF; GITHUB_EVENT_PATH=$1; export GITHUB_EVENT_PATH; shift; exec sh "$0" "$@"' "$W/scripts/doctor" "$@"; }

echo "== scripts/doctor =="
doctor
exits 0 "clean workspace";                        has "== result: 0 fail" "clean workspace has no failures"
hasnt "repository clone" "clean workspace: no clone warning"; hasnt "evidence directory" "clean workspace: no evidence warning"

reset; put scripts/check.conf '# step: commented out until code exists' '  # indented' '   '
doctor;            has "WARN  scripts/check.conf has no steps" "a conf without steps is reported"
put scripts/check.conf 'unit [fast]: echo unit ran'
doctor;            hasnt "check.conf has no steps" "a conf with a step is fine"
has "ok    verification contract configured" "… and reported as configured"
hasnt "prerequisite" "no requires line → no prerequisite output";  hasnt "profile fast" "… and no profile verdict"
put scripts/check.conf 'requires unit: true'
doctor;            has "WARN  scripts/check.conf has no steps" "a requires line is not a step"

# Prerequisites: reported per command and as a per-profile verdict; WARN in every mode.
reset; put scripts/check.conf 'compile [fast]: true' 'e2e: true' 'requires compile: true' \
  'requires e2e: echo runtime-miss""ing-text; exit 4'
doctor;            exits 0 "unmet prerequisite only warns"
has "ok    prerequisite met: true (steps: compile)" "a met prerequisite is an ok line naming its step"
has "WARN  prerequisite not met: echo runtime-miss\"\"ing-text; exit 4 (steps: e2e)" "an unmet one is a WARN naming step and command"
has "runtime-missing-text" "… with the command's output"
has "ok    profile fast: runnable on this machine" "unmet on a full-only step: fast stays runnable"
has "WARN  profile full: not runnable on this machine (steps: e2e)" "… full is not runnable, naming the step"
doctor --strict;   exits 0 "unmet prerequisite under --strict still only warns"
has "WARN  prerequisite not met" "… as a WARN, not a FAIL"
put scripts/check.conf 'compile [fast]: true' 'e2e: true' 'requires compile: exit 1'
doctor;            has "WARN  profile fast: not runnable on this machine (steps: compile)" "unmet on a fast step: fast not runnable"
has "WARN  profile full: not runnable on this machine (steps: compile)" "… and full neither"
put scripts/check.conf 'a: true' 'requires a: no-such-cmd-anew'
doctor;            exits 0 "missing prerequisite command does not abort doctor"
has "WARN  prerequisite not met: no-such-cmd-anew" "… it is reported as not met";  has "not found" "… with the shell's error text"
put scripts/check.conf 'a: true' 'requires b: true'
doctor;            has "WARN  check.conf: requires names no step: b" "a requires line naming no step is reported"
has "WARN  profile full: check fails on the check.conf errors above" "… and no profile is called runnable"
put scripts/check.conf 'a: true' 'requires a: # runtime to be decided'
doctor;            has "WARN  check.conf: requires has no command: a" "a comment-only prerequisite command is a conf error"
put scripts/check.conf 'a: true' 'requires : true'
doctor;            has "requires names no step: (empty)" "an empty step name is shown as (empty)"
: > "$TMP/doc-count"
put scripts/check.conf 'a [fast]: true' 'b: true' 'c: true' "requires a: echo x >> '$TMP/doc-count'" \
  "requires b: echo x >> '$TMP/doc-count'" "requires c: echo x >> '$TMP/doc-count'"
doctor;            has "(steps: a, b, c)" "a shared prerequisite is listed once for all its steps"
[ "$(wc -l < "$TMP/doc-count" | tr -d ' ')" -eq 1 ]; report $? "a prerequisite on three steps runs once per doctor run"
put scripts/check.conf 'e2e: true' 'requires e2e: true' 'requires e2e: exit 1'
doctor;            has "ok    prerequisite met: true (steps: e2e)" "one step, one met prerequisite: ok"
has "WARN  prerequisite not met: exit 1 (steps: e2e)" "… and one unmet: WARN";  has "WARN  profile full: not runnable on this machine (steps: e2e)" "… the step is not runnable"
put scripts/check.conf 'lint, format [fast]: true' 'e2e: true' 'requires lint, format: false'
doctor;            has "WARN  profile fast: not runnable on this machine (steps: lint, format)" "a step name with ', ' keeps the verdict exact"
put scripts/check.conf 'a\tb [fast]: true' 'requires a\tb: false'
doctor;            has "WARN  profile fast: not runnable on this machine (steps: a\tb)" "a backslash in a step name keeps the verdict exact"
put scripts/check.conf 'a: true' 'requires a:'
doctor;            has "WARN  check.conf: requires has no command: a" "an empty prerequisite command is a conf error"
has "WARN  profile full: check fails on the check.conf errors above" "… and no profile is called runnable"
put scripts/check.conf 'a: true' 'requires a'
doctor;            has "WARN  check.conf: requires line has no ':': requires a" "a requires line without ':' is a conf error"
put scripts/check.conf 'a: true' 'requires a: true' 'requires a: true'
doctor;            has "ok    prerequisite met: true (steps: a)" "the same requires line twice lists its step once"
printf 'requires\fx: true\n' > "$W/scripts/check.conf"
doctor;            hasnt "check.conf has no steps" "only a space or tab after 'requires' makes a requires line (as in check)"
hasnt "profile fast" "… and no prerequisite verdict is printed for it"

reset; put specs/plans/0001-plan.md '# Plan 0001' '- Approved by / on: —'
doctor;            has "WARN  plan exists for unapproved spec 0001" "plan without a spec → WARN locally"
doctor --strict;   exits 1 "plan without a spec under --strict"; has "FAIL  plan exists for unapproved spec 0001" "… FAIL under --strict"

reset; put specs/active/0002-draft.md '# Spec 0002' '- Status: Draft'; put specs/plans/0002-plan.md '# Plan 0002' '- Approved by / on: —'
doctor;            has "plan exists for unapproved spec 0002 (spec status: Draft)" "plan for a Draft spec is a gate violation"

reset; put specs/active/0003-wip.md '# Spec 0003' '- Status: In progress'; put specs/plans/0003-plan.md '# Plan 0003' '- Approved by / on: —'
doctor;            has "build started without recorded plan approval (spec 0003" "In progress without plan approval is caught"
put specs/plans/0003-plan.md '# Plan 0003' '- Approved by / on: Ada, 2026-10-16'
doctor;            hasnt "build started without recorded plan approval" "a recorded approval clears it"

reset; put specs/done/0004-old.md '# Spec 0004' '- Status: Shipped'; commit "ship 0004"
put specs/done/0004-old.md '# Spec 0004' '- Status: Shipped' 'edited after shipping'
doctor --strict;   exits 1 "edited shipped spec under --strict"; has "shipped spec changed: specs/done/0004-old.md" "edit under specs/done/ is caught"

reset; put specs/active/0005-a.md '# Spec 0005' '- Status: Draft'; put specs/done/0005-b.md '# Spec 0005' '- Status: Shipped'
doctor;            has "duplicate spec number 0005" "twin spec numbers are caught"

reset; put specs/done/0006-c.md '# Spec 0006' '- Status: Approved'
doctor;            has "specs/done/0006-c.md is not marked 'Status: Shipped'" "unmarked shipped spec is caught"

# Self-critique status: pending on a Draft warns; past approval it is a gate.
reset; put specs/active/0030-sc.md '# Spec 0030' '- Status: Draft' '- Self-critique: pending (after 0029 ships)'
doctor;            has "WARN  self-critique pending (after 0029 ships): specs/active/0030-sc.md" "pending self-critique on a Draft → WARN with its condition"
put specs/active/0030-sc.md '# Spec 0030' '- Status: Approved' '- Self-critique: pending (after 0029 ships)'
doctor --strict;   exits 1 "pending self-critique on an Approved spec under --strict"
has "FAIL  self-critique still pending (after 0029 ships) on a spec past approval" "… is a gate"
put specs/active/0030-sc.md '# Spec 0030' '- Status: In progress' '- Self-critique: pending (x)'
doctor;            has "WARN  self-critique still pending (x) on a spec past approval" "… In progress too (WARN locally)"
put specs/active/0030-sc.md '# Spec 0030' '- Status: Approved' '- Self-critique: Pending (y)'
doctor;            has "self-critique still Pending (y) on a spec past approval" "the pending status in any case"
put specs/active/0030-sc.md '# Spec 0030' '- Status: Approved' '- Self-critique: done'
doctor;            hasnt "self-critique" "self-critique done → no line"
put specs/active/0030-sc.md '# Spec 0030' '- Status: Approved'
doctor;            hasnt "self-critique" "no Self-critique field (older spec) → no line"

# New ships (vs the base ref): every criterion checked, or moved out at the ship gate with a target.
doctor_base() { run sh -c 'unset GITHUB_BASE_REF GITHUB_EVENT_PATH; ANEW_BASE_REF=$1; export ANEW_BASE_REF; shift; exec sh "$0" "$@"' "$W/scripts/doctor" "$@"; }
reset; put specs/done/0020-new.md '# Spec 0020' '- Status: Shipped' '- [x] AC-1 — proven' '- [ ] AC-2 — unproven'
doctor;            has "WARN  unchecked criterion in a new ship: specs/done/0020-new.md AC-2" "an uncommitted new ship with an unproven criterion → WARN"
hasnt "0020-new.md AC-1" "… a checked criterion is fine"
commit "ship 0020"
doctor_base "$BASE" --strict
exits 1 "new ship with an unproven criterion under --strict"; has "FAIL  unchecked criterion in a new ship: specs/done/0020-new.md AC-2" "… FAIL, naming spec and criterion"
doctor;            hasnt "criterion in a new ship" "a spec already shipped at the base is not judged again"
reset; put specs/done/0021-mini.md '# Spec 0021 (mini)' '- Status: Shipped' '- [x] CB-1 — done' '- [ ] PB-1 — not proven'
doctor;            has "unchecked criterion in a new ship: specs/done/0021-mini.md PB-1" "mini-spec CB-/PB- lines are judged too"
reset; put specs/done/0022-move.md '# Spec 0022' '- Status: Shipped' '- [ ] ~~AC-1 — c~~ → moved to B-3 — Ada, 2026-10-29, needs a newer runtime'
doctor;            has "moved criterion has no backlog entry: specs/done/0022-move.md AC-1 → B-3" "a move to a backlog entry that does not exist → gate"
put specs/backlog.md '# Backlog' '- **B-3** — needs a newer runtime'
doctor;            hasnt "0022-move.md" "a move to an existing backlog entry is accepted"
put specs/done/0022-move.md '# Spec 0022' '- Status: Shipped' '- [ ] AC-1 — c -> moved to B-3 — Ada, 2026-10-29'
doctor;            hasnt "0022-move.md" "the ASCII arrow is accepted too"
put specs/done/0022-move.md '# Spec 0022' '- Status: Shipped' '- [ ] ~~AC-1 — c~~'
doctor;            has "unchecked criterion in a new ship: specs/done/0022-move.md AC-1" "striking a criterion through without a target does not move it"
put specs/done/0022-move.md '# Spec 0022' '- Status: Shipped' '- [ ] AC-1 — c → moved to spec 0007'
doctor;            has "moved criterion has no open target spec: specs/done/0022-move.md AC-1 → spec 0007" "a move to a spec that does not exist → gate"
put specs/active/0007-later.md '# Spec 0007' '- Status: Draft'
doctor;            hasnt "0022-move.md" "a move to an existing spec is accepted"
put specs/done/0022-move.md '# Spec 0022' '- Status: Shipped' 'Sensitive area: payments' '- [ ] AC-1 — c → moved to spec 0007'
doctor;            has "a sensitive-area criterion cannot be moved out: specs/done/0022-move.md AC-1" "a sensitive-area criterion is never moved out"
put specs/done/0022-move.md '# Spec 0022' '- Status: Shipped' '- Sensitive area: none' '- [ ] AC-1 — c → moved to spec 0007'
doctor;            hasnt "0022-move.md" "'Sensitive area: none' is not a sensitive area"
put specs/done/0022-move.md '# Spec 0022' '- Status: Shipped' 'This is not a Sensitive area: just prose.' '- [ ] AC-1 — c → moved to spec 0007'
doctor;            hasnt "0022-move.md" "prose mentioning a sensitive area is not a declaration"
put specs/done/0022-move.md '# Spec 0022' '- Status: Shipped' '- sensitive areas: payments' '- [ ] AC-1 — c → moved to spec 0007'
doctor;            has "a sensitive-area criterion cannot be moved out: specs/done/0022-move.md AC-1" "'Sensitive areas:' in any case is a declaration"
put specs/done/0022-move.md '# Spec 0022' '- Status: Shipped' '- [ ] AC-1 — c → moved to foo'
doctor;            has "moved criterion has no target: specs/done/0022-move.md AC-1" "an unknown move target → gate"
put specs/done/0022-move.md '# Spec 0022' '- Status: Shipped' '- [ ] AC-1 — c → moved to spec 0022'
doctor;            has "moved criterion targets its own spec: specs/done/0022-move.md AC-1" "a spec cannot move a criterion to itself"
put specs/done/0005-old.md '# Spec 0005' '- Status: Shipped' '- [x] AC-1 — ok'
put specs/done/0022-move.md '# Spec 0022' '- Status: Shipped' '- [ ] AC-1 — c → moved to spec 0005'
doctor;            has "moved criterion has no open target spec: specs/done/0022-move.md AC-1 → spec 0005" "a shipped spec is no target (moved work stays open)"
put specs/done/0022-move.md '# Spec 0022' '- Status: Shipped' '- [ ] AC-1 — doctor rejects a line without `→ moved to B-3` marker'
doctor;            has "unchecked criterion in a new ship: specs/done/0022-move.md AC-1" "a marker in backticks is quoted text, not a move"
put specs/backlog.md '# Backlog' '- B-4 — bare id, not an entry'
put specs/done/0022-move.md '# Spec 0022' '- Status: Shipped' '- [ ] ~~AC-1 — c~~ → moved to B-4'
doctor;            has "moved criterion has no backlog entry: specs/done/0022-move.md AC-1 → B-4" "a backlog entry is **B-<n>**, not a bare mention"
reset; put specs/done/0023-md.md '# Spec 0023' '- Status: Shipped' '* [ ] AC-1 — star bullet' '1. [ ] **AC-2** — numbered, bold' '- [X] AC-3 — capital X is ticked'
doctor;            has "unchecked criterion in a new ship: specs/done/0023-md.md AC-1 —" "a '*' bullet criterion is judged (exact id)"
has "unchecked criterion in a new ship: specs/done/0023-md.md AC-2" "a numbered, bold criterion is judged";  hasnt "0023-md.md AC-3" "[X] counts as ticked"
reset; put specs/done/0032-fc.md '# Spec 0032' '- Status: Shipped' '1) [ ] AC-1 — paren list' '- []AC-2 — empty box' '| AC-3 | evidence row, no box |' '- [x] **AC-4** — ticked'
doctor;            has "unchecked criterion in a new ship: specs/done/0032-fc.md AC-1 —" "fail closed: a '1)' list criterion is judged"
has "unchecked criterion in a new ship: specs/done/0032-fc.md AC-2 —" "… an empty box is unchecked"
hasnt "0032-fc.md AC-3" "… a line without a checkbox (evidence table) is not a criterion";  hasnt "0032-fc.md AC-4" "… a ticked one is fine"
put specs/backlog.md '# Backlog' '- **B-3** — x'
put specs/done/0032-fc.md '# Spec 0032' '- Status: Shipped' '- [ ] AC-1 — c → moved to B-3 — Ada, 2026-10-29, was ~~B-2~~'
doctor;            hasnt "0032-fc.md" "a ~~ after the marker does not hide the move"
put specs/active/0007-later.md '# Spec 0007' '- Status: Draft'
for decl in '- **Sensitive area:** payments' '* Sensitive area: payments' '__Sensitive areas__: payments'; do
  put specs/done/0032-fc.md '# Spec 0032' '- Status: Shipped' "$decl" '- [ ] AC-1 — c → moved to spec 0007'
  doctor;          has "a sensitive-area criterion cannot be moved out: specs/done/0032-fc.md AC-1" "sensitive declared as '$decl' blocks a move"
done
for decl in '- Sensitive area: None — docs only' '- Sensitive area: n/a'; do
  put specs/done/0032-fc.md '# Spec 0032' '- Status: Shipped' "$decl" '- [ ] AC-1 — c → moved to spec 0007'
  doctor;          hasnt "0032-fc.md" "'$decl' is not sensitive"
done
reset; put specs/done/0034-first.md '# Spec 0034' '- Status: Shipped' '- [ ] AC-2 — unproven, depends on [x] AC-1' '- [ ] AC-3 — a ship shows `- [x] AC-1` lines' '- [x] AC-4 — proven; see [ ] AC-9'
doctor;            has "unchecked criterion in a new ship: specs/done/0034-first.md AC-2 —" "a [x] AC-n inside the text does not tick the criterion"
has "unchecked criterion in a new ship: specs/done/0034-first.md AC-3 —" "… nor in backticks";  hasnt "0034-first.md AC-9" "the first box and id decide (a ticked line is not judged by a later box)"
hasnt "0034-first.md AC-1" "… and the id is the first one on the line"
put specs/active/0007-later.md '# Spec 0007' '- Status: Draft'
for decl in '- Sensitive area(s): none' '- Sensitive area — none' '- Sensitive area: `none`' '- Sensitive area: (none)' 'Sensitive areas are not touched by this change.'; do
  put specs/done/0034-first.md '# Spec 0034' '- Status: Shipped' "$decl" '- [ ] AC-1 — c → moved to spec 0007'
  doctor;          hasnt "0034-first.md" "'$decl' does not make the spec sensitive"
done
for decl in '- Sensitive area:' '1) Sensitive area: payments' '- Sensitive area: nonexistent-flag'; do
  put specs/done/0034-first.md '# Spec 0034' '- Status: Shipped' "$decl" '- [ ] AC-1 — c → moved to spec 0007'
  doctor;          has "a sensitive-area criterion cannot be moved out: specs/done/0034-first.md AC-1" "'$decl' makes the spec sensitive (fail closed)"
done
put specs/backlog.md '# Backlog' '- **B-3** — x'
put specs/done/0034-first.md '# Spec 0034' '- Status: Shipped' '- [ ] ~~AC-1 — c~~ → moved to B-3'
doctor;            hasnt "0034-first.md" "a struck id is cut at its closing ~~, the marker after it counts"
put specs/done/0034-first.md '# Spec 0034' '- Status: Shipped' '- [ ] ~~AC-1 — → moved to B-3 inside the strike~~ no marker after'
doctor;            has "unchecked criterion in a new ship: specs/done/0034-first.md AC-1 —" "… a marker inside the struck text does not count"
reset; put "specs/done/0035-ödeme.md" '# Spec 0035' '- Status: Shipped' '- [x] AC-1 — ok'; commit "ship 0035"
put "specs/done/0035-ödeme.md" '# Spec 0035' '- Status: Shipped' '- [x] AC-1 — ok' 'edited'
doctor;            has "shipped spec changed: specs/done/0035-ödeme.md" "immutability names a non-ASCII spec unquoted"
reset; put specs/done/0033-old.md '# Spec 0033' '- Status: Shipped' '- [ ] AC-1 — old, unchecked'; commit "ship 0033"
put specs/done/0033-old.md '# Spec 0033' '- Status: Shipped' '- [ ] AC-1 — old, unchecked' 'edited'
doctor;            has "shipped spec changed: specs/done/0033-old.md" "an edited shipped spec is an immutability gate"
hasnt "criterion in a new ship" "… and never judged as a new ship"
reset; put specs/done/0024-none.md '# Spec 0024' '- Status: Shipped' 'criteria lost in an edit'
doctor;            has "WARN  new ship has no criterion line: specs/done/0024-none.md" "a new ship with no criterion line warns"
reset; put "specs/done/0025-ödeme.md" '# Spec 0025' '- Status: Shipped' '- [ ] AC-1 — x'
doctor;            has "unchecked criterion in a new ship: specs/done/0025-ödeme.md AC-1" "a non-ASCII spec name is judged (untracked)"
git -C "$W" add -A
doctor;            has "unchecked criterion in a new ship: specs/done/0025-ödeme.md AC-1" "… and staged"
reset; printf '# Spec 0026\n- Status: Shipped\n- [ ] AC-1 \377 latin-1 byte\n' > "$W/specs/done/0026-enc.md"
run env LC_ALL=C.UTF-8 sh -c 'unset ANEW_BASE_REF GITHUB_BASE_REF GITHUB_EVENT_PATH; exec sh "$0"' "$W/scripts/doctor"
has "unchecked criterion in a new ship: specs/done/0026-enc.md AC-1 —" "a spec with a non-UTF-8 byte is read, its id exact (UTF-8 locale)"
put specs/backlog.md '# Backlog' '- **B-3** — x'
printf '# Spec 0026\n- Status: Shipped\n- [ ] ~~AC-1 caf\351~~ \342\206\222 moved to B-3 \342\200\224 Ada\n' > "$W/specs/done/0026-enc.md"
run env LC_ALL=C.UTF-8 sh -c 'unset ANEW_BASE_REF GITHUB_BASE_REF GITHUB_EVENT_PATH; exec sh "$0"' "$W/scripts/doctor"
hasnt "0026-enc.md" "a valid move in a Latin-1 spec is accepted under a UTF-8 locale"
printf '# Spec 0026\n- Status: Shipped\n- [ ] AC-1 caf\351 \342\206\222 moved to B-3 \342\200\224 Ada\n' > "$W/specs/done/0026-enc.md"
run env LC_ALL=C.UTF-8 sh -c 'unset ANEW_BASE_REF GITHUB_BASE_REF GITHUB_EVENT_PATH; exec sh "$0"' "$W/scripts/doctor"
hasnt "0026-enc.md" "… also with the Latin-1 byte outside a strike (bytes, not characters)"
reset; put specs/done/0027-mini.md '# Spec 0027 (mini)' '- Status: Shipped' '- [x] CB-1 — ok' '- [ ] CB-2 — not proven'
doctor;            has "unchecked criterion in a new ship: specs/done/0027-mini.md CB-2" "an unchecked CB- line is judged"
# Base refs: an old ship next to a new one; the active → done move; the PR merge-base path.
reset; put specs/done/0028-old.md '# Spec 0028' '- Status: Shipped' '- [ ] AC-1 — old, unchecked'; commit "ship 0028"
OLD=$(git -C "$W" rev-parse HEAD)
put specs/active/0029-new.md '# Spec 0029' '- Status: In progress' '- [ ] AC-1 — new, unchecked'; commit "work 0029"
git -C "$W" mv specs/active/0029-new.md specs/done/0029-new.md; commit "ship 0029"
doctor_base "$OLD"
has "unchecked criterion in a new ship: specs/done/0029-new.md AC-1" "a committed active → done move is a new ship vs the base"
hasnt "0028-old.md" "… a spec already shipped at the base is not judged next to it"
git -C "$W" update-ref refs/remotes/origin/main "$OLD"
run sh -c 'unset ANEW_BASE_REF GITHUB_EVENT_PATH; GITHUB_BASE_REF=main; export GITHUB_BASE_REF; exec sh "$0" --strict' "$W/scripts/doctor"
exits 1 "PR base (GITHUB_BASE_REF): the new ship fails under --strict"
has "FAIL  unchecked criterion in a new ship: specs/done/0029-new.md AC-1" "… seen through the merge-base"
git -C "$W" update-ref -d refs/remotes/origin/main
# A workspace in a subdirectory of its repository: paths are workspace-relative.
reset; S="$TMP/sub"; mkdir -p "$S/ws"
( cd "$W" && tar -cf - --exclude=.git . ) | ( cd "$S/ws" && tar -xf - )
git -C "$S" init -q; git -C "$S" add -A
git -C "$S" -c user.name=selftest -c user.email=selftest@example.invalid commit -qm fixture
mkdir -p "$S/ws/specs/done"; printf '%s\n' '# Spec 0031' '- Status: Shipped' '- [ ] AC-1 — x' > "$S/ws/specs/done/0031-sub.md"
git -C "$S" add -A; git -C "$S" -c user.name=selftest -c user.email=selftest@example.invalid commit -qm ship
run sh -c 'unset GITHUB_BASE_REF GITHUB_EVENT_PATH; ANEW_BASE_REF=HEAD~1; export ANEW_BASE_REF; exec sh "$0"' "$S/ws/scripts/doctor"
has "unchecked criterion in a new ship: specs/done/0031-sub.md AC-1" "a workspace in a subdirectory of its repo sees a committed new ship"
printf '%s\n' '# Spec 0031' '- Status: Shipped' '- [ ] AC-1 — x' 'edited' > "$S/ws/specs/done/0031-sub.md"
run sh -c 'unset GITHUB_BASE_REF GITHUB_EVENT_PATH ANEW_BASE_REF; exec sh "$0"' "$S/ws/scripts/doctor"
has "shipped spec changed: specs/done/0031-sub.md" "immutability names the spec workspace-relative in a subdirectory"

reset; put specs/done/0010-fast.md '# Spec 0010' '- Status: Shipped' '| AC-1 | CHECK GREEN (fast, 2 steps, 4 s) |'
doctor;            exits 0 "fast evidence only warns"; has "WARN  fast output cited as evidence: specs/done/0010-fast.md" "a shipped spec citing only fast output is reported"
put specs/done/0010-fast.md '# Spec 0010' '- Status: Shipped' '| AC-1 | CHECK GREEN (fast, 2 steps, 4 s) · CHECK GREEN (full, 5 steps, 90 s) |'
doctor;            hasnt "fast output cited as evidence" "fast output next to full output is fine"
put specs/done/0010-fast.md '# Spec 0010' '- Status: Shipped' '| AC-1 | CHECK GREEN (fast = full: no steps tagged fast, 2 steps) |'
doctor;            hasnt "fast output cited as evidence" "an untagged conf's --fast run is a full run"
reset; printf '{"action":"opened","pull_request":{"body":"Evidence: CHECK GREEN (fast, 3 steps, 9 s)"}}\n' > "$TMP/pr.json"
doctor_pr "$TMP/pr.json"; has "WARN  fast output cited as evidence: the pull request description" "a PR citing only fast output is reported (CI)"
printf '{"action":"opened","pull_request":{"body":"Evidence: CHECK GREEN (full, 9 steps, 300 s)"}}\n' > "$TMP/pr.json"
doctor_pr "$TMP/pr.json"; hasnt "fast output cited as evidence" "a PR citing full output is fine"

reset; put specs/active/0007-mini.md '# Spec 0007 (mini)' '- Status: Draft' '- Source:' '## Preserved behavior'
doctor;            has "mini-spec 0007 has no Source work item" "mini-spec without Source is caught"

reset; put specs/active/0008-x.md '# Spec 0008' '- Status: Draft' '- Source: WI-1'; put specs/active/0009-y.md '# Spec 0009' '- Status: Draft' '- Source: WI-1'
doctor;            has "two open specs share Source 'WI-1'" "twin change requests are caught"

reset; mkdir -p "$W/evidence/demo-clone/.git" "$W/evidence/demo-clone/evidence" "$W/.evidence" "$W/vendor/sub"
printf 'gitdir: ../.git/modules/sub\n' > "$W/vendor/sub/.git"
doctor
exits 0 "evidence hygiene never fails";           has "repository clone inside the working tree: evidence/demo-clone" "nested clone is reported"
has "evidence directory found: evidence " "evidence/ is reported";  has "evidence directory found: .evidence " ".evidence/ is reported"
hasnt "evidence/demo-clone/evidence" "nothing inside a clone is reported twice"
hasnt "clone inside the working tree: vendor/sub" "a .git FILE (submodule, worktree) is not a clone"

if [ -f "$W/adapters/cursor/commands/plan.md" ]; then
  reset; rm -f "$W/adapters/cursor/commands/plan.md"
  doctor;          exits 1 "adapter parity broken"; has "FAIL  adapter parity: plan missing in cursor" "missing adapter command is a failure"
  reset; rm -rf "$W/adapters/codex/skills/plan"
  doctor;          exits 1 "codex parity broken"; has "FAIL  adapter parity: plan missing in codex" "missing codex skill is a failure"
  reset; rm -f "$W/adapters/codex/skills/plan/agents/openai.yaml"
  doctor;          has "FAIL  adapter parity: codex skill plan is not explicit-only" "a codex skill Codex could start by itself is a failure"
  reset; doctor;   hasnt "missing in codex" "restored codex adapter is clean"
else
  echo "skip  adapter parity (no adapters/ in this repo)"
fi

if [ -f "$W/adapters/claude-code/.claude/commands/plan.md" ]; then
  reset; sed '/^### `\/plan`$/d' "$W/docs/commands.md" > "$W/docs/commands.md.tmp" && mv "$W/docs/commands.md.tmp" "$W/docs/commands.md"
  doctor;          exits 1 "command reference drift"; has "FAIL  command reference out of date: /plan missing from docs/commands.md" "a removed command section is a failure"
  reset; doctor;   hasnt "command reference out of date" "restored reference is clean"
else
  echo "skip  command reference drift (no adapters/ in this repo)"
fi

if [ -f "$W/.anew-version" ]; then
  reset; doctor;   has "ok    ANEW base version: $(head -n 1 "$W/.anew-version" | tr -d '\r')" "doctor reports the ANEW base version"
  rm -f "$W/.anew-version"
  doctor;          exits 0 "missing .anew-version only warns"; has "WARN  .anew-version missing" "a missing version marker is reported"
fi
# The template itself (unconfigured AGENTS.md): the marker must match the newest CHANGELOG entry.
if grep -q 'STATUS: NOT CONFIGURED' "$ROOT/AGENTS.md" 2>/dev/null && [ -f "$ROOT/CHANGELOG.md" ]; then
  out="changelog: $(sed -n 's/^## \(v[0-9][0-9.]*\) .*/\1/p' "$ROOT/CHANGELOG.md" | head -n 1) · .anew-version: $(head -n 1 "$ROOT/.anew-version" 2>/dev/null | tr -d '\r')"
  [ "${out%% ·*}" = "changelog: ${out##*.anew-version: }" ]; report $? "template: .anew-version matches the newest CHANGELOG entry"
fi

reset; rm -f "$W/docs/testing.md"
doctor;            exits 1 "core file missing"; has "FAIL  missing: docs/testing.md" "missing core file is a failure"

echo "== selftest: $passed passed, $failed failed =="
[ "$failed" -eq 0 ] || exit 1
exit 0
