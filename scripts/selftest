has "WARN  plan 0040: criterion map names \`test_absent_name\` — no file holds it" "a map name no file holds → WARN"
has "names \`tests/unit/sample_test.txt::test_not_in_file\`" "… a missing part of a::b → WARN"
has "names \`nomatch_*\`" "… a wildcard prefix no file holds → WARN"
has "names \`test_only_in_spec\`" "… a name found only under specs/ → WARN"
has "names \`specs/active/0040-map.md\`" "… a path under specs/ → WARN"
hasnt "\`test_present_one\`" "a name in an untracked test file is held"
hasnt "\`tests/unit/sample_test.txt::test_in_file\`" "a path::name with both parts held is fine"
