# --- scripts/status: the same git-initialised copy, one fixture spec (and plan) per scenario ---
status() { run sh "$W/scripts/status" "$@"; }
mkspec() { put "specs/active/$1-demo.md" "# Spec $1 — demo" "" "- Status: $2" "- Mode: lite" \
  "- Plan: \`specs/plans/$1-plan.md\`" "- Self-critique: done" "" "## Intent" "Demo intent." "" \
  "## Requirements" "1. It works." "" "## Acceptance criteria" "- [ ] AC-1 — it works"; }
mkplan() { n=$1; a=$2; shift 2; put "specs/plans/$n-plan.md" "# Plan $n — demo" "" \
  "- Spec: \`specs/active/$n-demo.md\`" "- Status: Approved" "- Approved by / on: $a" "" \
  "## Files to change or add" "- app.txt" "" "## Ordered steps" "1. Write app.txt." "" \
  "## Build evidence" "$@"; }
GREEN="- CHECK GREEN (full, 1 steps, 1 s) @$BASE"

