# scripts/check.conf — the steps behind the single verification contract (./scripts/check).
# Generated by the bootstrap workflow; this example shows the format.
# One step per line:  <name>: <command>   — runs in order, fails fast.
#
# .NET example:
# build: dotnet build --nologo -warnaserror
# test: dotnet test --nologo
#
# Node example:
# lint: npm run lint
# typecheck: npm run typecheck
# test: npm test
#
# Python example:
# lint: ruff check .
# types: mypy .
# test: pytest -q
