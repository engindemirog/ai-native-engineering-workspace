#!/bin/sh
# ANEW residue test — docs/testing.md, Resource hygiene: a check run leaves nothing running.
# Measures processes and available memory, runs ./scripts/check twice back to back, and after
# each run compares against the baseline taken before the first.
#   ./scripts/residue          full profile
#   ./scripts/residue --fast   the fast profile (both run whenever check.conf changes)
# Exit 0 = clean, or not measured (check.conf has no steps); 1 = residue found or check red;
# 2 = usage. A new process counts only if it is still alive at a second look one settle period
# later, so short-lived background activity drops out. A survivor is check's residue only if its
# parent chain says so (attribute, below); what other sessions or the OS started meanwhile is
# listed as "not from check" with its parent and never fails the test, so no idle machine is
# needed. Memory is reported, never judged: with none of check's processes left, a drop is not check's.
# Tunables: ANEW_RESIDUE_SETTLE (seconds to wait after each run, default 5),
#           ANEW_RESIDUE_MB (memory drop in MB worth a note, default 512).
set -u
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

usage() {
  echo "usage: ./scripts/residue [--fast]" >&2
  echo "  runs ./scripts/check twice (same profile) and fails if processes or memory don't return" >&2
  echo "  to baseline. Env: ANEW_RESIDUE_SETTLE=<seconds> (5), ANEW_RESIDUE_MB=<tolerance> (512)" >&2
  exit 2
}
case "$#:${1:-}" in
  0:) profile=full ;;
  1:--fast) profile=fast ;;
  *) usage ;;
esac
settle=${ANEW_RESIDUE_SETTLE:-5}
tolerance=${ANEW_RESIDUE_MB:-512}
case "$settle" in ''|*[!0-9]*) usage ;; esac
case "$tolerance" in ''|*[!0-9]*) usage ;; esac

# A conf without steps runs nothing, so there is nothing to measure — say so instead of "clean".
# Same rule as check: blank or whitespace-only lines, (indented) comments and requires lines
# (prerequisites) are not steps.
CONF="$ROOT/scripts/check.conf"
ws=" $(printf '\t\r\v\f')"   # ASCII whitespace only, as in check
tab=$(printf '\t')            # a requires line: `requires`, then a space or tab — as in check
if [ -f "$CONF" ] && ! grep -q -v -e "^[$ws]*\$" -e "^[$ws]*#" -e "^[$ws]*requires[ $tab]" "$CONF"; then
  echo "RESIDUE NOT MEASURED ($profile): scripts/check.conf has no steps — rerun when steps exist"
  exit 0
fi

TMP=$(mktemp -d "${TMPDIR:-/tmp}/anew-residue.XXXXXX") || { echo "residue: mktemp failed" >&2; exit 1; }
trap 'rm -rf "$TMP"' EXIT INT TERM

# --- measure <file>: "pid<TAB>ppid<TAB>id<TAB>since<TAB>name<TAB>command" per process into
# <file>, available MB into $mem. Windows only (a PID can be reused there while its old children
# still name it as parent): id = creation time, part of the process's identity in every snapshot;
# since = the same time for the reuse check, left empty where the parent id came from MSYS.
# The measuring processes themselves are left out.
case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) os=windows ;; Darwin) os=darwin ;; *) os=posix ;; esac
measure() {
  mem=
  if [ "$os" = windows ]; then
    # One PowerShell call: it drops itself, its children and the shell stub that launched it.
    powershell.exe -NoProfile -NonInteractive -Command '
      $me = $PID; $all = Get-CimInstance Win32_Process
      $stub = ($all | Where-Object { $_.ProcessId -eq $me }).ParentProcessId
      "MEM`t" + (Get-CimInstance Win32_PerfFormattedData_PerfOS_Memory).AvailableMBytes
      $all | Where-Object { $_.ProcessId -ne $me -and $_.ProcessId -ne $stub -and $_.ParentProcessId -ne $me } |
        ForEach-Object { "{0}`t{1}`t{2}`t{3}`t{4}" -f $_.ProcessId, $_.ParentProcessId,
          $(if ($_.CreationDate) { $_.CreationDate.ToString("yyyyMMddHHmmssfff") } else { "" }), $_.Name,
          $(if ($_.CommandLine) { $_.CommandLine.Trim() } else { $_.Name }) }
    ' </dev/null 2>/dev/null | tr -d '\r' > "$TMP/raw" || return 1
    mem=$(awk -F'\t' '$1 == "MEM" { print $2 }' "$TMP/raw")
    # Git Bash (MSYS) runs exec as a new Windows process, so Windows' parent ids break inside
    # every shell pipeline. MSYS's own table keeps them: for an MSYS process whose MSYS parent is
    # another MSYS process, take that parent's current Windows pid (gone → "msys:<pid>"), and
    # leave "since" empty — its parent may have exec'd since, younger than the child. The id
    # stays, so a process keeps its identity when its MSYS parent exits. A stopped or tty-waiting
    # process carries a one-letter status before its PID. No ps at all → no repair.
    ps -el 2>/dev/null | awk 'NR > 1 { if ($1 !~ /^[0-9]+$/) { $1 = ""; $0 = $0 }
                                       print $1 "\t" $2 "\t" $4 }' > "$TMP/msys"
    awk -F'\t' -v OFS='\t' 'FILENAME == ARGV[1] { win[$1] = $3; par[$1] = $2; msys[$3] = $1; next }
      $1 == "MEM" { next }
      { since = $3 }
      ($1 in msys) && par[msys[$1]] > 1 { p = par[msys[$1]]; $2 = (p in win) ? win[p] : "msys:" p; since = "" }
      { print $1, $2, $3, since, $4, $5 }' "$TMP/msys" "$TMP/raw" > "$1"
  else
    if [ "$os" = darwin ]; then
      command -v vm_stat >/dev/null 2>&1 &&
        mem=$(vm_stat | awk '/page size of/ { ps = $8 } /^Pages (free|inactive|speculative)/ { gsub(/\./, "", $NF); n += $NF }
                             END { if (ps) printf "%d", n * ps / 1048576 }')
    elif [ -r /proc/meminfo ]; then
      mem=$(awk '/^MemAvailable:/ { printf "%d", $2 / 1024 }' /proc/meminfo)
    fi
    # Kernel threads ("[kworker/0:1]" on Linux) come and go with no user-space step behind them:
    # a bare bracketed name is one and is left out. A zombie ("[x] <defunct>") still counts.
    ps -e -o pid= -o ppid= -o args= > "$TMP/raw" || return 1
    awk '{ pid = $1; ppid = $2; sub(/^[ \t]*[0-9]+[ \t]+[0-9]+[ \t]*/, "")
           if ($0 ~ /^ps -e -o pid= -o ppid= -o args=/ || $0 ~ /^\[[^]]*\]$/) next
           name = $1; sub(/.*\//, "", name)
           print pid "\t" ppid "\t\t\t" name "\t" $0 }' "$TMP/raw" > "$1"
  fi
  case "$mem" in *[!0-9]*) mem= ;; esac
  [ -s "$1" ]
}
fail_measure() { echo "residue: cannot list processes on this platform" >&2; exit 2; }
# A process is the same one only with the same pid and creation time (pid alone on POSIX).
newer() { awk -F'\t' 'NR == FNR { seen[$1 FS $3] = 1; next } !(($1 FS $3) in seen)' "$1" "$2"; }   # in $2, not in $1
alive() { awk -F'\t' 'NR == FNR { now[$1 FS $3] = 1; next } (($1 FS $3) in now)' "$1" "$2"; }      # in $2, still in $1

# --- attribute <base> <snapshot> <survivors>: is each survivor check's? ---
# Follow the parent chain in the snapshot. A live parent from the baseline that is not one of
# this test's own ancestors → not from check (another session, an OS service). A parent that is
# gone (on Windows: or younger than its child, a reused pid) → orphaned, check's: a daemon detaches
# exactly so. On POSIX an orphan is handed to init or a subreaper, both ancestors of this test, so
# a parent among them → check's too (Windows never reparents and has no such rule). A new live
# parent → one level up. A chain too long or circular → check's (fail closed).
# Prints "C" (check's) or "F" (not from check), then pid, parent label and command, tab-separated.
ancestry() {
  [ "$os" = windows ] && return 0
  awk -F'\t' -v me="$$" '{ pp[$1] = $2 } END { a = me; printf "1"
         for (i = 0; i < 64 && a != "" && a != "0" && a != "1"; i++) { printf " %s", a; a = pp[a] } print "" }' "$1"
}
attribute() {
  awk -F'\t' -v os="$os" -v anc="$(ancestry "$2")" '
    BEGIN { n = split(anc, a, " "); for (i = 1; i <= n; i++) isanc[a[i]] = 1 }
    # younger(): on Windows, the live process under the parent pid was created after the child
    # (string compare, exact) — the pid was reused, the real parent is gone.
    function younger(p, cs) { return os == "windows" && id[p] != "" && cs != "" && (id[p] "") > (cs "") }
    FILENAME == ARGV[1] { base[$1 FS $3] = 1; next }
    FILENAME == ARGV[2] { pp[$1] = $2; id[$1] = $3; since[$1] = $4; nm[$1] = $5; there[$1] = 1; next }
    {
      label = (($2 in there) && !younger($2, $4)) ? $2 " " nm[$2] : $2 " gone"
      p = $2; cs = $4; verdict = "C"
      for (d = 0; d < 64; d++) {
        if (os != "windows" && (p in isanc)) break
        if (!(p in there)) break
        if (younger(p, cs)) break
        if ((p FS id[p]) in base) { verdict = "F"; break }
        cs = since[p]; p = pp[p]
      }
      printf "%s\t%s\t%s\t%s\n", verdict, $1, label, $6
    }' "$1" "$2" "$3"
}

# Warm-up first: the first measurement can start helpers (e.g. a WMI host) that must be in the baseline.
measure "$TMP/base" || fail_measure
measure "$TMP/base" || fail_measure
base_mem=$mem
echo "== residue test ($profile profile; settle ${settle}s, memory tolerance ${tolerance} MB) =="
echo "baseline: $(wc -l < "$TMP/base" | tr -d ' ') processes, ${base_mem:-?} MB available"
[ -n "$base_mem" ] || echo "note: memory is not measurable on this platform; processes only"

found=0
for run in 1 2; do
  if [ "$profile" = fast ]; then set -- --fast; else set --; fi
  echo "==> run $run/2: ./scripts/check${1:+ $1}"
  if ! sh "$ROOT/scripts/check" "$@" </dev/null; then
    echo "RESIDUE TEST ABORTED ($profile): check failed in run $run — the residue test needs a green check" >&2
    exit 1
  fi
  sleep "$settle"
  measure "$TMP/run" || fail_measure
  run_mem=$mem
  newer "$TMP/base" "$TMP/run" > "$TMP/new"
  if [ -s "$TMP/new" ]; then          # second look: transient processes have exited by now
    sleep "$settle"
    measure "$TMP/again" || fail_measure
    alive "$TMP/again" "$TMP/new" > "$TMP/survivors"
    attribute "$TMP/base" "$TMP/again" "$TMP/survivors" > "$TMP/judged"
  else
    : > "$TMP/judged"
  fi
  n=$(grep -c '^C' "$TMP/judged")
  m=$(grep -c '^F' "$TMP/judged")
  line="after run $run: $(wc -l < "$TMP/run" | tr -d ' ') processes, $n survivor(s), $m not from check"
  if [ -n "$base_mem" ] && [ -n "$run_mem" ]; then
    line="$line; $run_mem MB available ($((run_mem - base_mem)) MB vs baseline)"
    if [ $((base_mem - run_mem)) -gt "$tolerance" ]; then
      line="$line — over the ${tolerance} MB tolerance (informational: memory is not check's once none of its processes survive)"
    fi
  fi
  echo "$line"
  [ "$n" -gt 0 ] && found=1
  awk -F'\t' '$1 == "C" { printf "  survivor  %s  %s  (parent %s)\n", $2, $4, $3 }' "$TMP/judged"
  awk -F'\t' '$1 == "F" { printf "  not from check  %s  %s  (parent %s)\n", $2, $4, $3 }' "$TMP/judged"
done

if [ "$found" -ne 0 ]; then
  echo "RESIDUE FOUND ($profile): stop what survived inside the step that starts it (docs/testing.md, Resource hygiene)" >&2
  exit 1
fi
echo "RESIDUE CLEAN ($profile, 2 runs)"
