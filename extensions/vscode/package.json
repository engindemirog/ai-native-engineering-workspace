{
  "name": "anew",
  "displayName": "ANEW",
  "description": "The whole ANEW process on a screen — add ANEW to a project or start a new one, set up, start work, approve, triage, ship — over scripts/adopt, scripts/status, scripts/gate and scripts/init.",
  "version": "0.4.0",
  "publisher": "anew",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/engindemirog/ai-native-engineering-workspace"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:scripts/status",
    "onStartupFinished"
  ],
  "main": "./out/extension.cjs",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "ANEW runs the workspace's own scripts/status and scripts/gate."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "anew",
          "title": "ANEW",
          "icon": "media/anew.svg"
        }
      ]
    },
    "views": {
      "anew": [
        {
          "id": "anew.work",
          "type": "webview",
          "name": "Work",
          "when": "anew.active"
        },
        {
          "id": "anew.welcome",
          "name": "Get started",
          "when": "!anew.active"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "anew.welcome",
        "contents": "This folder has no ANEW yet. Add the ANEW core from the latest release — files that exist are kept, nothing is committed.\n[Add ANEW to this project](command:anew.adopt)\nOr start a project of its own:\n[New ANEW project](command:anew.newProject)",
        "when": "workspaceFolderCount > 0"
      },
      {
        "view": "anew.welcome",
        "contents": "No folder is open. Start a new project with ANEW from the latest release:\n[New ANEW project](command:anew.newProject)",
        "when": "workspaceFolderCount == 0"
      }
    ],
    "commands": [
      {
        "command": "anew.refresh",
        "title": "ANEW: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "anew.open",
        "title": "ANEW: Open"
      },
      {
        "command": "anew.newWork",
        "title": "ANEW: New work"
      },
      {
        "command": "anew.adopt",
        "title": "ANEW: Add ANEW to this project"
      },
      {
        "command": "anew.newProject",
        "title": "ANEW: New ANEW project"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "anew.refresh",
          "when": "view == anew.work",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "anew.refresh",
          "when": "anew.active"
        },
        {
          "command": "anew.newWork",
          "when": "anew.active"
        },
        {
          "command": "anew.open",
          "when": "false"
        },
        {
          "command": "anew.adopt",
          "when": "!anew.active && workspaceFolderCount > 0"
        }
      ]
    },
    "configuration": {
      "title": "ANEW",
      "properties": {
        "anew.shell": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "The POSIX shell that runs scripts/status and scripts/gate. Empty: sh on Linux and macOS, Git for Windows' bash.exe on Windows."
        },
        "anew.templateRepository": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "The GitHub repository whose latest release Add and New copy ANEW from: owner/name or its URL. Empty: the official ANEW template."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.cjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --test \"test/*.test.ts\"",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
